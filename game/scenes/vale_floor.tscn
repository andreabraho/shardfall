[gd_scene load_steps=13 format=3]

; zone_vale_floor — the second field map (WLD-05), band 7–11.
;
; Deliberately the opposite shape to the Approach. That one is a corridor the player is
; pushed along; this is a basin they cross, with the two shrines far apart and the camps
; between them. A chain of maps that are all corridors is one long map with loading screens
; in it, so the second one has to be somewhere you choose a line through.
;
; The barrow mounds are the landmark: they block sight rather than movement, so the far side
; of the basin is revealed by walking, not by arriving.

[ext_resource type="Script" path="res://scripts/World/ZoneRoot.cs" id="1_zoneroot"]
[ext_resource type="Script" path="res://scripts/World/NavBaker.cs" id="2_navbaker"]
[ext_resource type="Script" path="res://scripts/World/KitPiece.cs" id="3_kit"]
