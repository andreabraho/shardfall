; Flagstones, two metres, rows offset: black and deep violet at random, a violet seam between.
[sub_resource type="Shader" id="Shader_flags"]
code = "shader_type spatial;

uniform vec3 black : source_color = vec3(0.07, 0.06, 0.09);
uniform vec3 violet : source_color = vec3(0.16, 0.08, 0.24);
uniform vec3 seam : source_color = vec3(0.16, 0.06, 0.24);

varying vec3 wp;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 p = wp.xz / 2.0;
	float row = floor(p.y);
	p.x += mod(row, 2.0) * 0.5;
	vec2 cell = floor(p);
	vec2 f = fract(p);
	float h = hash(cell);
	vec3 stone = mix(black, violet, step(0.55, hash(cell + 7.3)));
	stone *= 0.7 + 0.55 * h;
	stone *= 0.88 + 0.24 * hash(floor(wp.xz * 5.0));
	float edge = min(min(f.x, 1.0 - f.x), min(f.y, 1.0 - f.y));
	float g = smoothstep(0.015, 0.045, edge);
	ALBEDO = mix(seam, stone, g);
	EMISSION = seam * (1.0 - g) * 0.2;
	ROUGHNESS = 0.8 - 0.3 * h;
}"

