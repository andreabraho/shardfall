[ext_resource type="Script" path="res://scripts/World/ShrineNode.cs" id="6_shrine"]
[ext_resource type="Script" path="res://scripts/Visual/VisualRoot.cs" id="7_visualroot"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="8_player"]
[ext_resource type="PackedScene" path="res://scenes/session.tscn" id="9_session"]

