[gd_scene load_steps=12 format=3]

; zone_ember_hollow — the first village and the ground around it (WLD-06).
;
; The layout the whole world is built on: a walled village that is safe ground, one road out,
; and camps close enough to see from the wall but far enough that nothing standing in them can
; reach someone inside. That distance is not taste — ZoneRoot.Audit fails the scene if a camp
; comes within six metres of the village, so the three camps below sit forty metres out.
;
; Everything the player walks on or into is a kit piece naming an id and nothing else, and
; every creature here is tuning in game/data/zones/act1.json. This file is coordinates.

[ext_resource type="Script" path="res://scripts/World/ZoneRoot.cs" id="1_zoneroot"]
[ext_resource type="Script" path="res://scripts/World/NavBaker.cs" id="2_navbaker"]
[ext_resource type="Script" path="res://scripts/World/KitPiece.cs" id="3_kit"]
