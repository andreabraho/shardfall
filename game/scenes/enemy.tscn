[gd_scene load_steps=5 format=3]

; Data-driven enemy. EnemyId picks the definition from game/data/enemies/, which supplies
; stats, aggro/leash radii, move speed and the placeholder visual (ENG-07). Changing an
; enemy's numbers is a JSON edit, never a scene edit.

[ext_resource type="Script" path="res://scripts/Combat/EnemyBrain.cs" id="1_brain"]
[ext_resource type="Script" path="res://scripts/Combat/Combatant.cs" id="2_combatant"]
[ext_resource type="Script" path="res://scripts/Visual/VisualRoot.cs" id="3_visual"]
[ext_resource type="Script" path="res://scripts/Combat/HealthBar3D.cs" id="4_bar"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_enemy"]
radius = 0.45
height = 1.7

[node name="Enemy" type="CharacterBody3D"]
collision_layer = 4
; World + Enemy: without the Enemy bit, enemies walk through each other and stack,
; which puts two health bars in the same place and reads as one bar jumping at random.
collision_mask = 5
script = ExtResource("1_brain")
EnemyId = "mob_corrupted_wolf"

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, 0)
shape = SubResource("CapsuleShape3D_enemy")

[node name="NavigationAgent3D" type="NavigationAgent3D" parent="."]
path_desired_distance = 0.5
target_desired_distance = 1.8
radius = 0.45
height = 1.7

[node name="VisualRoot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, 0)
script = ExtResource("3_visual")
VisualId = "mesh_placeholder_quadruped"

[node name="HealthBar3D" type="Node3D" parent="."]
; Position is driven by the script (TopLevel + Offset), so no transform here.
script = ExtResource("4_bar")

[node name="Combatant" type="Node" parent="."]
script = ExtResource("2_combatant")
