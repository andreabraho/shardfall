  {
    "id": "zone_catacombs",
    "music": "mus_catacombs",
    "name": "$zone.zone_catacombs.name",
    "kind": "dungeon",
    "level_band": [19, 23],
    "scene": "res://scenes/catacombs.tscn",
    "exits": [
      { "to": "zone_broken_gate" }
    ],
    "shrines": [
      { "id": "shr_catacombs_mouth", "name": "$shrine.shr_catacombs_mouth.name", "fast_travel": true },
      { "id": "shr_catacombs_gallery", "name": "$shrine.shr_catacombs_gallery.name", "fast_travel": false },
      { "id": "shr_catacombs_vault", "name": "$shrine.shr_catacombs_vault.name", "fast_travel": false }
    ],
    "spawn_fields": [],
    "shards": ["shd_demon_stone", "shd_demon_shard"],
    "floors": [
      // Floor 1: break the demon stone. Its own waves are the fight; a few crawlers wander in.
      { "id": "flr_the_mouth", "name": "$floor.flr_the_mouth.name", "task": "break", "targets": 1, "stone": "shd_demon_stone", "shrine": "shr_catacombs_mouth", "waves": ["mob_zombie_crawler", "mob_zombie_ghoul"], "wave_size": 2, "wave_seconds": 22 },
      // From here up everything the floor sends hunts the player, and a pack is kept at strength.
      { "id": "flr_the_cistern", "name": "$floor.flr_the_cistern.name", "task": "hold", "seconds": 90, "waves": ["mob_zombie_crawler", "mob_zombie_ghoul", "mob_ribcage_spitter"], "wave_size": 4, "wave_seconds": 12, "pack": 6 },
      { "id": "flr_the_gallery", "name": "$floor.flr_the_gallery.name", "task": "fight", "boss": "mob_rotting_colossus", "waves": ["mob_zombie_crawler", "mob_zombie_ghoul"], "wave_size": 3, "wave_seconds": 20 },
      // Every lantern lets out a crowd when it breaks. The true one ends the floor once all of them are dead.
      { "id": "flr_the_lantern_walk", "name": "$floor.flr_the_lantern_walk.name", "task": "find", "targets": 1, "decoys": 4, "burst": 7, "shrine": "shr_catacombs_gallery", "bench": true, "waves": ["mob_zombie_ghoul", "mob_ribcage_spitter", "mob_zombie_crawler"], "wave_size": 2, "wave_seconds": 28 },
      // Each keystone is sealed until the guard that rises round it is dead.
      { "id": "flr_the_sealed_crossing", "name": "$floor.flr_the_sealed_crossing.name", "task": "carry", "targets": 3, "guard": 8, "refuge": true, "waves": ["mob_zombie_brute", "mob_blue_demon_hexer", "mob_zombie_ghoul"], "wave_size": 2, "wave_seconds": 26 },
      { "id": "flr_the_choir_vault", "name": "$floor.flr_the_choir_vault.name", "task": "fight", "boss": "mob_blue_demon_sorcerer", "waves": ["mob_demon_warrior", "mob_hell_imp"], "wave_size": 3, "wave_seconds": 18 },
      // Four demon stones against the clock, which starts with the first.
      { "id": "flr_the_falling_stair", "name": "$floor.flr_the_falling_stair.name", "task": "race", "targets": 4, "seconds": 150, "stone": "shd_demon_shard", "shrine": "shr_catacombs_vault", "bench": true, "waves": ["mob_demon_warrior", "mob_hell_imp"], "wave_size": 2, "wave_seconds": 16 },
      // The second floor again, harder: a bigger pack, heavier waves, a longer clock.
      { "id": "flr_the_black_cloister", "name": "$floor.flr_the_black_cloister.name", "task": "hold", "seconds": 110, "waves": ["mob_demon_warrior", "mob_blue_demon_hexer", "mob_hell_imp", "mob_zombie_brute"], "wave_size": 5, "wave_seconds": 11, "pack": 9 },
      // The Demon Lord: help at 75, 50 and 25 per cent, an enrage at half, and the tower's creatures on the side.
      { "id": "flr_the_heart", "name": "$floor.flr_the_heart.name", "task": "fight", "boss": "mob_demon_lord", "boss_adds": 6, "enrage": true, "waves": ["mob_demon_warrior", "mob_hell_imp"], "wave_size": 3, "wave_seconds": 22 }
    ]
  }
]
