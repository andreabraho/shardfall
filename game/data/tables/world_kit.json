[
  // Ground. Authored at real size so a scene places them on a grid without scaling.
  { "id": "kit_floor_4",        "shape": "box",      "size": [4.0, 0.25, 4.0],  "color": "#3a4038" },
  { "id": "kit_floor_8",        "shape": "box",      "size": [8.0, 0.25, 8.0],  "color": "#3a4038" },
  { "id": "kit_path_4",         "shape": "box",      "size": [4.0, 0.12, 2.5],  "color": "#5a5044" },
  { "id": "kit_ramp_4",         "shape": "ramp",     "size": [4.0, 1.50, 4.0],  "color": "#3f453d" },

  // Walls. A village is mostly these: a perimeter with one way in.
  { "id": "kit_wall_4",         "shape": "box",      "size": [4.0, 3.00, 0.60], "color": "#6b7280" },
  { "id": "kit_wall_8",         "shape": "box",      "size": [8.0, 3.00, 0.60], "color": "#6b7280" },
  { "id": "kit_wall_low_4",     "shape": "box",      "size": [4.0, 1.10, 0.50], "color": "#6b7280" },
  { "id": "kit_tower",          "shape": "cylinder", "size": [2.4, 5.50, 2.4],  "color": "#737c88" },
  { "id": "kit_gate",           "shape": "arch",     "size": [5.0, 4.20, 1.00], "color": "#828b97" },

  // Terrain. Cliffs are what turn an open plane into a route.
  { "id": "kit_cliff_8",        "shape": "box",      "size": [8.0, 6.00, 3.00], "color": "#4e5550" },
  { "id": "kit_boulder",        "shape": "sphere",   "size": [2.2, 1.90, 2.2],  "color": "#5c625c" },
  { "id": "kit_pillar",         "shape": "cylinder", "size": [1.2, 4.00, 1.2],  "color": "#79817d" },

  // Ruins — placed after the bake, so they are solid but not navigation geometry: a
  // half-collapsed wall should block the player without carving a hole in the mesh.
  { "id": "kit_ruin_wall",      "shape": "box",      "size": [3.2, 1.80, 0.55], "color": "#6a6055", "navigation": false },
  { "id": "kit_ruin_rubble",    "shape": "sphere",   "size": [1.6, 0.70, 1.6],  "color": "#6a6055", "navigation": false },

  // Decoration. Walked through, never collided with, never baked.
  { "id": "kit_banner",         "shape": "box",      "size": [0.1, 2.40, 0.90], "color": "#8f4a4a", "solid": false, "navigation": false },
  { "id": "kit_brazier",        "shape": "cylinder", "size": [0.7, 1.10, 0.7],  "color": "#b07038", "solid": false, "navigation": false },
  { "id": "kit_shrub",          "shape": "sphere",   "size": [1.3, 1.00, 1.3],  "color": "#4c6b46", "solid": false, "navigation": false },
  { "id": "kit_marker_post",    "shape": "cylinder", "size": [0.3, 2.20, 0.3],  "color": "#9a8a6a", "solid": false, "navigation": false }
]
