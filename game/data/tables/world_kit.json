[
  // Sizes are the contract, not the models. Every scene in the game was laid out against the
  // numbers below — walls run end to end at eight metres because a piece is eight metres — so
  // a model is stretched to fill its box rather than the box being redrawn around the model.
  // Collision is built from the size too, never from the mesh — but the *shape* of it is its
  // own field. That was learned the hard way: pointing the gate at a model changed its
  // collider from two legs to one solid box and sealed the village shut, because what was
  // drawn and what stopped you were the same word. "collision" is only written where the two
  // differ, which is every piece that is not a box.
  //
  // Models: KayKit Dungeon Remastered 1.0, CC0. See ASSET-LICENSES.md.
  // Anything still on a primitive is there because the pack has no equivalent, not because
  // nobody got to it — it is a dungeon pack, and it has no cliffs, boulders or foliage.

  // Ground. Authored at real size so a scene places them on a grid without scaling.
  { "id": "kit_floor_4",        "shape": "model",    "size": [4.0, 0.25, 4.0],  "color": "#3a4038", "model_path": "res://assets/kaykit/dungeon/floor_tile_large.glb" },
  { "id": "kit_floor_8",        "shape": "model",    "size": [8.0, 0.25, 8.0],  "color": "#3a4038", "model_path": "res://assets/kaykit/dungeon/floor_tile_large.glb" },
  { "id": "kit_path_4",         "shape": "model",    "size": [4.0, 0.12, 2.5],  "color": "#5a5044", "model_path": "res://assets/kaykit/dungeon/floor_dirt_small_A.glb" },
  { "id": "kit_ramp_4",         "shape": "model",    "size": [4.0, 1.50, 4.0],  "color": "#3f453d", "model_path": "res://assets/kaykit/dungeon/stairs_wide.glb" },

  // Walls. A village is mostly these: a perimeter with one way in.
  { "id": "kit_wall_4",         "shape": "model",    "size": [4.0, 3.00, 0.60], "color": "#6b7280", "model_path": "res://assets/kaykit/dungeon/wall.glb" },
  { "id": "kit_wall_8",         "shape": "model",    "size": [8.0, 3.00, 0.60], "color": "#6b7280", "model_path": "res://assets/kaykit/dungeon/wall.glb" },
  { "id": "kit_wall_low_4",     "shape": "model",    "size": [4.0, 1.10, 0.50], "color": "#6b7280", "model_path": "res://assets/kaykit/dungeon/wall_half.glb" },
  { "id": "kit_tower",          "shape": "model",    "size": [2.4, 5.50, 2.4],  "color": "#737c88", "collision": "cylinder", "model_path": "res://assets/kaykit/dungeon/column.glb" },
  { "id": "kit_gate",           "shape": "model",    "size": [5.0, 4.20, 1.00], "color": "#828b97", "collision": "arch",     "model_path": "res://assets/kaykit/dungeon/wall_doorway.glb" },

  // Terrain. Cliffs are what turn an open plane into a route — and the one thing an indoor
  // pack cannot supply, so these stay primitives until an outdoor pack lands.
  { "id": "kit_cliff_8",        "shape": "box",      "size": [8.0, 6.00, 3.00], "color": "#4e5550" },
  { "id": "kit_boulder",        "shape": "sphere",   "size": [2.2, 1.90, 2.2],  "color": "#5c625c" },
  { "id": "kit_pillar",         "shape": "model",    "size": [1.2, 4.00, 1.2],  "color": "#79817d", "collision": "cylinder", "model_path": "res://assets/kaykit/dungeon/pillar_decorated.glb" },

  // Ruins — placed after the bake, so they are solid but not navigation geometry: a
  // half-collapsed wall should block the player without carving a hole in the mesh.
  { "id": "kit_ruin_wall",      "shape": "model",    "size": [3.2, 1.80, 0.55], "color": "#6a6055", "navigation": false, "model_path": "res://assets/kaykit/dungeon/wall_broken.glb" },
  { "id": "kit_ruin_rubble",    "shape": "model",    "size": [1.6, 0.70, 1.6],  "color": "#6a6055", "navigation": false, "collision": "sphere", "model_path": "res://assets/kaykit/dungeon/rubble_half.glb" },

  // Decoration. Walked through, never collided with, never baked.
  { "id": "kit_banner",         "shape": "model",    "size": [0.1, 2.40, 0.90], "color": "#8f4a4a", "solid": false, "navigation": false, "model_path": "res://assets/kaykit/dungeon/banner_red.glb" },
  { "id": "kit_brazier",        "shape": "model",    "size": [0.7, 1.10, 0.7],  "color": "#b07038", "solid": false, "navigation": false, "model_path": "res://assets/kaykit/dungeon/torch_lit.glb" },
  { "id": "kit_shrub",          "shape": "sphere",   "size": [1.3, 1.00, 1.3],  "color": "#4c6b46", "solid": false, "navigation": false },
  { "id": "kit_marker_post",    "shape": "model",    "size": [0.3, 2.20, 0.3],  "color": "#9a8a6a", "solid": false, "navigation": false, "model_path": "res://assets/kaykit/dungeon/torch.glb" },

  // -- Village and woods: Quaternius Medieval Village and Stylized Nature MegaKits (CC0; map
  // themes, 2026-09-23). The village kit is drawn on a 2 m grid, so its walls tile rather than
  // stretch: an 8 m wall is four modules, and the bricks stay brick-sized. Natural things keep
  // their proportions ("fit": "height") and pick a variant and a turn from where they stand,
  // so a wood is a wood and not one tree stamped a hundred times.

  // The town wall and its gate. Same footprint as the dungeon wall it replaces in the village.
  { "id": "kit_vil_wall_8",     "shape": "model", "size": [8.0, 3.12, 0.60], "color": "#8a7a68", "tile": 4, "model_path": "res://assets/quaternius/village/Wall_UnevenBrick_Straight.gltf" },
  { "id": "kit_vil_wall_4",     "shape": "model", "size": [4.0, 3.12, 0.60], "color": "#8a7a68", "tile": 2, "model_path": "res://assets/quaternius/village/Wall_UnevenBrick_Straight.gltf" },
  { "id": "kit_vil_gate",       "shape": "model", "size": [5.0, 4.20, 1.00], "color": "#8a7a68", "collision": "arch", "model_path": "res://assets/quaternius/village/Wall_UnevenBrick_Door_Round.gltf" },
  { "id": "kit_vil_corner",     "shape": "model", "size": [0.9, 3.40, 0.90], "color": "#8a7a68", "collision": "cylinder", "model_path": "res://assets/quaternius/village/Corner_Exterior_Brick.gltf" },

  // Houses: prefab scenes of wall modules and a roof (assets/quaternius/village/houses). The
  // collider is the walls only — the roof overhang is not something the player walks into.
  { "id": "kit_vil_house_small",   "shape": "model", "fit": "height", "size": [8.3, 8.0, 8.1],  "collision_size": [6.4, 3.2, 6.4], "color": "#c8b89a", "model_path": "res://assets/quaternius/village/houses/HouseSmall.tscn" },
  { "id": "kit_vil_house_long",    "shape": "model", "fit": "height", "size": [8.3, 8.0, 9.7],  "collision_size": [6.4, 3.2, 8.4], "color": "#c8b89a", "model_path": "res://assets/quaternius/village/houses/HouseLong.tscn" },
  { "id": "kit_vil_house_stone",   "shape": "model", "fit": "height", "size": [8.3, 8.0, 9.7],  "collision_size": [6.4, 3.2, 8.4], "color": "#9a8a78", "model_path": "res://assets/quaternius/village/houses/HouseStone.tscn" },
  { "id": "kit_vil_house_cottage", "shape": "model", "fit": "height", "size": [5.5, 6.8, 7.6],  "collision_size": [4.4, 3.2, 6.4], "color": "#c8b89a", "model_path": "res://assets/quaternius/village/houses/HouseCottage.tscn" },

  // Village ground and clutter.
  { "id": "kit_vil_square_8",   "shape": "model", "size": [8.0, 0.12, 8.0], "color": "#7a6a5a", "tile": 4, "model_path": "res://assets/quaternius/village/Floor_UnevenBrick.gltf" },
  { "id": "kit_vil_path_4",     "shape": "model", "size": [4.0, 0.12, 2.5], "color": "#7a6e60", "tile": 2, "model_path": "res://assets/quaternius/nature/RockPath_Square_Wide.gltf" },
  { "id": "kit_vil_wagon",      "shape": "model", "size": [2.0, 1.55, 4.0], "color": "#7a5a3a", "navigation": false, "model_path": "res://assets/quaternius/village/Prop_Wagon.gltf" },
  { "id": "kit_vil_crate",      "shape": "model", "size": [1.1, 1.10, 1.1], "color": "#7a5a3a", "navigation": false, "model_path": "res://assets/quaternius/village/Prop_Crate.gltf" },
  { "id": "kit_vil_fence_4",    "shape": "model", "size": [4.0, 0.90, 0.25], "color": "#7a5a3a", "tile": 2, "model_path": "res://assets/quaternius/village/Prop_WoodenFence_Extension1.gltf" },

  // Woods. Stopped by the trunk, drawn with the crown.
  { "id": "kit_nat_tree",       "shape": "model", "fit": "height", "random_yaw": true, "size": [4.4, 7.6, 4.4], "collision_size": [0.9, 4.0, 0.9], "collision": "cylinder", "color": "#4c6b46", "models": ["res://assets/quaternius/nature/CommonTree_1.gltf","res://assets/quaternius/nature/CommonTree_2.gltf","res://assets/quaternius/nature/CommonTree_3.gltf","res://assets/quaternius/nature/CommonTree_4.gltf","res://assets/quaternius/nature/CommonTree_5.gltf"] },
  { "id": "kit_nat_pine",       "shape": "model", "fit": "height", "random_yaw": true, "size": [4.4, 7.4, 4.4], "collision_size": [0.9, 4.0, 0.9], "collision": "cylinder", "color": "#3f5a3c", "models": ["res://assets/quaternius/nature/Pine_1.gltf","res://assets/quaternius/nature/Pine_2.gltf","res://assets/quaternius/nature/Pine_3.gltf","res://assets/quaternius/nature/Pine_4.gltf","res://assets/quaternius/nature/Pine_5.gltf"] },
  { "id": "kit_nat_rock",       "shape": "model", "fit": "height", "random_yaw": true, "size": [3.2, 2.2, 3.0], "collision_size": [2.6, 2.2, 2.6], "collision": "cylinder", "color": "#6b6d68", "models": ["res://assets/quaternius/nature/Rock_Medium_1.gltf","res://assets/quaternius/nature/Rock_Medium_2.gltf","res://assets/quaternius/nature/Rock_Medium_3.gltf"] },
  { "id": "kit_nat_crag",       "shape": "model", "fit": "height", "random_yaw": true, "size": [8.0, 5.5, 8.0], "collision_size": [6.4, 5.5, 6.4], "collision": "cylinder", "color": "#5c605a", "models": ["res://assets/quaternius/nature/Rock_Medium_1.gltf","res://assets/quaternius/nature/Rock_Medium_3.gltf"] },

  // Undergrowth: walked through, never baked.
  { "id": "kit_nat_bush",       "shape": "model", "fit": "height", "random_yaw": true, "size": [1.9, 1.4, 1.9], "solid": false, "navigation": false, "color": "#4c6b46", "models": ["res://assets/quaternius/nature/Bush_Common.gltf","res://assets/quaternius/nature/Bush_Common_Flowers.gltf"] },
  { "id": "kit_nat_grass",      "shape": "model", "fit": "height", "random_yaw": true, "size": [1.0, 0.8, 1.0], "solid": false, "navigation": false, "color": "#5f7d4a", "models": ["res://assets/quaternius/nature/Grass_Common_Tall.gltf","res://assets/quaternius/nature/Grass_Wispy_Tall.gltf"] },
  { "id": "kit_nat_flowers",    "shape": "model", "fit": "height", "random_yaw": true, "size": [1.2, 0.9, 1.2], "solid": false, "navigation": false, "color": "#b89ac8", "models": ["res://assets/quaternius/nature/Flower_3_Group.gltf","res://assets/quaternius/nature/Flower_4_Group.gltf","res://assets/quaternius/nature/Mushroom_Common.gltf"] },
  { "id": "kit_nat_fern",       "shape": "model", "fit": "height", "random_yaw": true, "size": [2.4, 1.1, 2.4], "solid": false, "navigation": false, "color": "#4c6b46", "models": ["res://assets/quaternius/nature/Fern_1.gltf","res://assets/quaternius/nature/Plant_1_Big.gltf"] }
]
