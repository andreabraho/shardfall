[
  // The three people Ember Hollow needs (QST-06, FR-7.2). Where each one stands is the
  // village scene's business; this is what they say and sell.
  //
  // Dialogue is linear (FR-8.2): one line per press of the key, no choices, and then they
  // start again. The elder's quest lines come first while that quest is the active one — it
  // is how the road gets pointed at without a journal.
  //
  // Every name and line is a key; the English is in data/strings/en.json (UIX-06).

  { "id": "npc_corwen", "name": "$npc.npc_corwen.name", "title": "$npc.title.elder",
    "role": "talk", "zone": "zone_ember_hollow", "visual": "mesh_placeholder_villager", "tint": "#8a7fb0",
    "quest_lines": {
      "qst_reeds_in_the_hollow":    "$npc.npc_corwen.qst_reeds_in_the_hollow",
      "qst_thornbacks_on_the_road": "$npc.npc_corwen.qst_thornbacks_on_the_road",
      "qst_the_gnawing_barrows":    "$npc.npc_corwen.qst_the_gnawing_barrows",
      "qst_wolves_of_the_ridge":    "$npc.npc_corwen.qst_wolves_of_the_ridge",
      "qst_breakers_at_the_gate":   "$npc.npc_corwen.qst_breakers_at_the_gate",
      "qst_into_the_catacombs":     "$npc.npc_corwen.qst_into_the_catacombs"
    },
    "lines": [
      "$npc.npc_corwen.line_1",
      "$npc.npc_corwen.line_2",
      "$npc.npc_corwen.line_3"
    ] },

  { "id": "npc_hesk", "name": "$npc.npc_hesk.name", "title": "$npc.title.smith",
    "role": "smith", "zone": "zone_ember_hollow", "visual": "mesh_placeholder_villager", "tint": "#b0703c",
    "lines": [
      "$npc.npc_hesk.line_1",
      "$npc.npc_hesk.line_2"
    ] },

  { "id": "npc_idra", "name": "$npc.npc_idra.name", "title": "$npc.title.merchant",
    "role": "merchant", "zone": "zone_ember_hollow", "visual": "mesh_placeholder_villager", "tint": "#5f9a6a",
    "lines": [
      "$npc.npc_idra.line_1",
      "$npc.npc_idra.line_2"
    ],
    "stock": {
      "staples": ["mat_iron_scrap", "mat_tempering_oil", "mat_boring_stone", "mat_mutation_ink"],
      "rotating": 5,
      "max_rarity": "fine"
    } }
]
