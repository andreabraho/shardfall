[gd_scene load_steps=4 format=3]

; WebSheet — a spider's web, 3 m across: one quad and a shader that draws the spokes and the
; spiral. Seen from both sides. Kit piece kit_web.



[sub_resource type="Shader" id="WebShader"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, blend_mix, depth_draw_never, shadows_disabled;

uniform vec4 tint : source_color = vec4(0.93, 0.93, 0.96, 0.85);

void fragment() {
	vec2 p = UV * 2.0 - 1.0;
	float r = length(p);
	float a = atan(p.y, p.x);
	float spokes = 11.0;
	float seg = fract(a / 6.2831853 * spokes + 0.5) - 0.5;
	float spoke = 1.0 - smoothstep(0.0, 0.018, abs(seg) * r * 6.2831853 / spokes);
	float ring = 0.5 - abs(fract(r * 8.0 + 0.12 * sin(a * spokes)) - 0.5);
	float thread = 1.0 - smoothstep(0.0, 0.07, ring);
	float mask = 1.0 - smoothstep(0.82, 1.0, r);
	ALBEDO = tint.rgb;
	ALPHA = max(spoke, thread * step(0.08, r)) * mask * tint.a;
}"

[sub_resource type="ShaderMaterial" id="Web"]
render_priority = 1
shader = SubResource("WebShader")

[sub_resource type="QuadMesh" id="Sheet"]
size = Vector2(1, 1)

[node name="WebSheet" type="Node3D"]

[node name="Web" type="MeshInstance3D" parent="."]
transform = Transform3D(3, 0, 0, 0, 3, 0, 0, 0, 1, 0, 0, 0)
mesh = SubResource("Sheet")
surface_material_override/0 = SubResource("Web")
cast_shadow = 0
