[gd_scene load_steps=10 format=3]

; WebStone — map four's shard: a standing stone half-buried in a drift of sand and wrapped in
; webs, bones at its foot. ShardGlow burns the "Stone" only. Visual mesh_shard_web, ~4.2 m.

[ext_resource type="PackedScene" path="res://assets/quaternius/nature/Rock_Medium_3.gltf" id="1_rock_medium_3glt"]
[ext_resource type="PackedScene" path="res://assets/kaykit/halloween/skull.gltf" id="2_skullgltf"]
