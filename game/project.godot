; Kiln — Godot project configuration
;
; Deliberately minimal and hand-authored. Godot rewrites this file when you change
; settings in the editor, which produces clean diffs because it is plain text.

config_version=5

[application]

config/name="Kiln"
config/description="A single-player action RPG in the spirit of Metin2."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="Kiln.Game"

[display]

; Design resolution. The window itself is sized separately below.
window/size/viewport_width=1920
window/size/viewport_height=1080

; Borderless fullscreen (3), not a 1920x1080 window. A window exactly the size of the
; screen sits *under* the Windows taskbar, which is why the bar stayed visible along the
; bottom and the game only looked full screen. Toggle with F11 or Alt+Enter.
window/size/mode=3

; Size used when the player toggles back to windowed — deliberately smaller than any
; common screen so the window is obviously a window.
window/size/window_width_override=1600
window/size/window_height_override=900

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[autoload]

; Runs before any scene. Installs input bindings and loads content (see scripts/Bootstrap.cs).
Game="*res://scripts/Bootstrap.cs"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="PlayerHitbox"
3d_physics/layer_5="EnemyHitbox"
3d_physics/layer_6="Interactable"
3d_physics/layer_7="GroundClick"
3d_physics/layer_8="Telegraph"

[navigation]

; Must match the NavigationMesh cell size in arena.tscn, or Godot rasterizes navmesh
; edges against a coarser grid and paths drift near walls and pillars.
3d/default_cell_size=0.15
3d/default_cell_height=0.15

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=2
